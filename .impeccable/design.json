  "narrative": {
    "northStar": "L'éphéméride de bureau",
    "overview": "Le site se lit comme on arrache la feuille du jour : la date d'abord, puis ce qui est tombé, ce qui arrive et ce qui attend une action. Le monde de l'éphéméride ne prête que quatre choses à un écran de travail : un papier froid bleuté, une encre bleu nuit, une grotesque condensée pour les chiffres et une signature, le feuillet daté. La mise en page, la navigation et les contrôles restent ceux d'un produit web ordinaire.",
    "keyCharacteristics": [
      "Bandeau de navigation bleu de Prusse plein, onglet actif souligné de vermillon.",
      "Toute date d'échéance est un feuillet : bandeau du mois, grand quantième condensé.",
      "Vermillon réservé aux dates à venir, à l'urgence et à ce qui demande une action.",
      "Chiffres en Barlow Condensed auto-hébergée, texte en police système.",
      "Couleurs de piliers et de réglementations (reprises de Notion) traitées comme séries de données."
    ],
    "rules": [
      {
        "name": "La règle du vermillon compté",
        "body": "Le vermillon ne sert qu'à dater et à alerter. Un élément vermillon doit répondre à « quand ? » ou « que dois-je faire ? ».",
        "section": "colors"
      },
      {
        "name": "La règle des couleurs Notion",
        "body": "Piliers et réglementations gardent les teintes de Notion (bleu, violet, orange, rose, ambre, émeraude, sarcelle, cyan) en étiquettes pâles : ce sont des données, pas l'identité.",
        "section": "colors"
      },
      {
        "name": "La règle des chiffres condensés",
        "body": "Barlow Condensed ne porte que des chiffres, des mois et le mot « Radar » : jamais une phrase.",
        "section": "typography"
      },
      {
        "name": "La règle de la bordure seule",
        "body": "Un panneau a une bordure ou une ombre, jamais les deux au repos.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** dater chaque échéance avec un feuillet, partout où elle apparaît.",
      "**Do** utiliser les jetons (papier, feuille, encre, filet, prusse, vermillon, alerte) plutôt que des couleurs Tailwind brutes.",
      "**Do** dessiner les icônes en SVG au trait de 1,75 px (`components/Icones.tsx`).",
      "**Do** garder les chiffres en `font-chiffres` et les nombres en chiffres tabulaires."
    ],
    "donts": [
      "**Don't** utiliser le vermillon pour décorer : il signifie date ou urgence.",
      "**Don't** ajouter de surtitres en capitales espacées au-dessus des titres.",
      "**Don't** remplacer une icône par un caractère Unicode (★, ↗, ▶).",
      "**Don't** ajouter d'animations d'entrée aux cartes ou aux sections ; le seul mouvement est le feuillet du jour."
    ]
  }
}