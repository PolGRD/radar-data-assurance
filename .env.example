# Copier ce fichier en .env.local pour un test sur ordinateur (jamais commité).
# En production, ces valeurs se saisissent dans Vercel > Settings > Environment Variables.

# Secret de l'intégration Notion « Radar site »
NOTION_TOKEN=

# Mot de passe unique du site
SITE_PASSWORD=

# Clé de signature du cookie de connexion : une longue chaîne aléatoire (32 caractères ou plus)
AUTH_SECRET=
